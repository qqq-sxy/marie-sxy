# Copy this file to ".env" (gitignored). Never commit real keys.

# --- Recommended: one key + one model (switch providers by changing these two lines) ---
MARIE_SXY_API_KEY=
# Examples:
# MARIE_SXY_MODEL=gpt-4o-mini
# MARIE_SXY_MODEL=deepseek/deepseek-chat
# MARIE_SXY_MODEL=anthropic/claude-3-5-sonnet-20241022
MARIE_SXY_MODEL=gpt-4o-mini

# --- Optional: LiteLLM provider keys (only if you do NOT use MARIE_SXY_API_KEY) ---
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# --- Other ---
# MARIE_SXY_ENV_FILE=/path/to/custom.env
# MARIE_SXY_OFFLINE=1
